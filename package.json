{
  "name": "autonomous-qa-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Electron 기반 관리자웹 자율 QA 테스트 시스템",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "dev:fixture": "pnpm --filter @qa/fixture-admin dev",
    "qa": "pnpm --filter @qa/engine start --",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
